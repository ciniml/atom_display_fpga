// Unit test for sync_fifo (util/sync_fifo.veryl).
// The FIFO is first-word-fall-through with a block-RAM body plus a
// 1-entry output skid register, so total capacity is DEPTH+1.
// SPDX-License-Identifier: BSL-1.0

#[test(test_sync_fifo)]
#[allow(unassign_variable)]
module test_sync_fifo {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (
        clk: clk,
    );

    inst s_in : stream_if::<stream_test_pkg::byte_t>;
    inst s_out: stream_if::<stream_test_pkg::byte_t>;

    var count: logic<3>;
    var wrote: logic<4>;
    var got  : logic<8>;

    inst dut: sync_fifo::<stream_test_pkg::byte_t> #(
        DepthBits: 2, // RAM depth 4, total capacity 5
    ) (
        i_clk  : clk  ,
        i_rst  : rst  ,
        i_data : s_in ,
        o_data : s_out,
        o_count: count,
    );

    initial {
        s_in.valid   = 1'b0;
        s_in.payload = 8'h00;
        s_out.ready  = 1'b0;
        rst.assert(clk);

        $assert(s_out.valid == 1'b0);
        $assert(s_in.ready == 1'b1);
        $assert(count == 3'd0);

        // Fill to full while the output is stalled (total capacity 5).
        s_in.valid   = 1'b1;
        wrote        = '0;
        s_in.payload = 8'ha0;
        for _i in 0..8 {
            if s_in.ready {
                wrote        += 1;
                clk.next(1);
                s_in.payload  = (8'ha0 + wrote) as 8;
            } else {
                break;
            }
        }
        s_in.valid = 1'b0;
        $assert(wrote == 4'd5, "total capacity DEPTH+1 = 5");
        $assert(s_in.ready == 1'b0, "must be full");
        $assert(count == 3'd5, "count reflects total occupancy");
        $assert(s_out.valid == 1'b1);
        $assert(s_out.payload == 8'ha0, "FIFO order");

        // Drain and verify order (accept one word per cycle it is valid).
        s_out.ready = 1'b1;
        for i in 0..5 {
            for _j in 0..8 {
                if s_out.valid {
                    break;
                }
                clk.next(1);
            }
            $assert(s_out.valid == 1'b1, "drained word must be present");
            $assert(s_out.payload == (8'ha0 + i) as 8, "FIFO order");
            clk.next(1);
        }
        s_out.ready = 1'b0;
        clk.next(2);
        $assert(s_out.valid == 1'b0, "must be empty after drain");
        $assert(count == 3'd0);

        // Round-trip more than DEPTH words to exercise pointer wrap,
        // one word at a time, checking order is preserved.
        for i in 0..10 {
            s_in.valid   = 1'b1;
            s_in.payload = (8'h10 + i) as 8;
            for _j in 0..8 {
                if s_in.ready {
                    break;
                }
                clk.next(1);
            }
            $assert(s_in.ready == 1'b1, "must accept the word");
            clk.next(1);
            s_in.valid = 1'b0;

            s_out.ready = 1'b1;
            for _j in 0..8 {
                if s_out.valid {
                    break;
                }
                clk.next(1);
            }
            $assert(s_out.valid == 1'b1, "word must come back");
            got = s_out.payload;
            $assert(got == (8'h10 + i) as 8, "order preserved across wrap");
            clk.next(1);
            s_out.ready = 1'b0;
        }

        $finish();
    }
}
