// line_reader.veryl
// Reads one line of pixels from the frame buffer over AXI4 (read-only,
// burst) and outputs a pixel stream, handling unaligned start addresses
// with a byte realignment buffer.
// Veryl port of fpga_samples stream_reader.scala (LineReader).
// Supports 16bpp and 24bpp pixels (video_pkg::PIXEL_BITS) on a 32-bit bus.
// SPDX-License-Identifier: BSL-1.0

// The command is a plain valid/ready/payload port triple instead of a
// stream_if: nested generics (LineReaderCommand::<A, W>) are not
// accepted as interface generic args at port positions, and opaque
// type parameters do not allow member access.
pub module line_reader::<AddressBits: u32, MaxWidth: u32, BurstPixels: u32, MaxBurstLength: u32> #(
    // R-channel FIFO depth. The Chisel original used 2048; because the
    // valid/ready backpressure never drops data, the depth only affects
    // read throughput, and the issue control (issued_data_words_remaining)
    // keeps at most a burst or two in flight, so a smaller RAM suffices.
    // 512 x 35 bit still fits in one block RAM per instance.
    param RFifoDepthBits: u32 = 9,
) (
    i_clk          : input   clock                                                ,
    i_rst          : input   reset                                                ,
    i_command_valid: input   logic                                                ,
    o_command_ready: output  logic                                                ,
    i_command      : input   video_pkg::LineReaderCommand::<AddressBits, MaxWidth>,
    o_data         : modport stream_if::<video_pkg::VideoSignal>::master          ,
    axi            : modport axi4_if::<AddressBits, 32>::read_master              ,
    o_busy         : output  logic                                                ,
) {
    const PIXEL_BYTES     : u32 = video_pkg::PIXEL_BYTES; // 2 (16bpp) or 3 (24bpp)
    const DATA_BYTES      : u32 = 4; // 32-bit bus
    const ADDR_MASK_BITS  : u32 = 2;
    const READ_BURST_WORDS: u32 = BurstPixels * PIXEL_BYTES / DATA_BYTES;
    const COUNT_H_BITS    : u32 = $clog2(MaxWidth + 1);
    const WORDS_BITS      : u32 = $clog2(PIXEL_BYTES * MaxWidth);
    const BYTES_BITS      : u32 = WORDS_BITS + 2;
    // Realignment buffer size: double buffer of lcm(DATA_BYTES, PIXEL_BYTES)
    // when the lcm equals the larger side (16bpp: 2*4 = 8), plain lcm
    // otherwise (24bpp: lcm(4,3) = 12). Both equal DATA_BYTES*PIXEL_BYTES.
    const REALIGN_BUF_BYTES: u32 = DATA_BYTES * PIXEL_BYTES;
    const IDX_BITS         : u32 = $clog2(REALIGN_BUF_BYTES);
    // Slot counts: bus words in / pixels out per buffer
    const IN_SLOTS     : u32 = REALIGN_BUF_BYTES / DATA_BYTES; // = PIXEL_BYTES
    const OUT_SLOTS    : u32 = REALIGN_BUF_BYTES / PIXEL_BYTES; // = DATA_BYTES
    const IN_SLOT_BITS : u32 = $clog2(IN_SLOTS);
    const OUT_SLOT_BITS: u32 = $clog2(OUT_SLOTS);

    enum State: logic<2> {
        s_idle,
        s_decode,
        s_running,
    }
    var state: State;

    var command: video_pkg::LineReaderCommand::<AddressBits, MaxWidth>;

    let start_address_aligned: logic<AddressBits> = {command.start_address[AddressBits - 1:ADDR_MASK_BITS], 2'b00};
    // count * PIXEL_BYTES without a multiplier (x2, or x3 = x2 + x1)
    let count_bytes_x2       : logic<BYTES_BITS>  = {1'b0 repeat BYTES_BITS - COUNT_H_BITS - 1, command.count, 1'b0};
    let count_bytes          : logic<BYTES_BITS>  = if PIXEL_BYTES == 2 ?
        count_bytes_x2
    :
        count_bytes_x2 + {1'b0 repeat BYTES_BITS - COUNT_H_BITS, command.count}
    ;
    let bytes_to_transfer    : logic<BYTES_BITS>  = ({1'b0 repeat BYTES_BITS - 2, command.start_address[1:0]})
        + count_bytes;
    let words_to_transfer    : logic<WORDS_BITS>  = ((bytes_to_transfer + 3) >> 2) as WORDS_BITS;

    var next_address               : logic<AddressBits> ;
    var address_words_remaining    : logic<WORDS_BITS>  ;
    var data_words_remaining       : logic<WORDS_BITS>  ;
    var issued_data_words_remaining: logic<WORDS_BITS>  ;
    var pixels_remaining           : logic<COUNT_H_BITS>;

    // Realignment buffer: in = 4-byte bus words, out = PIXEL_BYTES pixels.
    // Positions are tracked as slot counters (word slot for the input,
    // pixel slot for the output) plus a "lap" parity flag per pointer.
    // Slots keep the buffer read/write muxes shallow (a byte-granular
    // index would need an adder in front of a 12:1 byte mux at 24bpp,
    // which showed up on the critical path) and the full/empty
    // comparators read register outputs directly.
    var realign_buffer: logic<8> [REALIGN_BUF_BYTES];
    var in_slot : logic<IN_SLOT_BITS> ;
    var out_slot: logic<OUT_SLOT_BITS>;
    var in_side : logic               ;
    var out_side: logic               ;

    // Byte positions of the slots (5 bits: values up to 12)
    let in_bytes : logic<5> = {1'b0 repeat 5 - IN_SLOT_BITS - 2, in_slot, 2'b00};
    let out_bytes: logic<5> = if PIXEL_BYTES == 2 ?
        {1'b0 repeat 5 - OUT_SLOT_BITS - 1, out_slot, 1'b0}
    :
        ({1'b0 repeat 5 - OUT_SLOT_BITS - 1, out_slot, 1'b0}) + ({1'b0 repeat 5 - OUT_SLOT_BITS, out_slot})
    ;

    let realign_full : logic = ((in_bytes + DATA_BYTES) >: out_bytes) && (in_side != out_side);
    let realign_empty: logic = ((out_bytes + PIXEL_BYTES) >: in_bytes) && (in_side == out_side);

    // Pixel phase within the first bus word -> initial slots.
    // 16bpp: pixel byte = start_address[1] * 2 -> out slot [0, 1].
    // 24bpp: pixel byte = ((4 - addr[1:0]) % 4) * 3 = [0, 9, 6, 3]
    //        -> out slot [0, 3, 2, 1]; containing word -> in slot [0, 2, 1, 0].
    var initial_out_slot: logic<OUT_SLOT_BITS>;
    var initial_in_slot : logic<IN_SLOT_BITS> ;
    always_comb {
        if PIXEL_BYTES == 2 {
            initial_out_slot = {1'b0 repeat OUT_SLOT_BITS - 1, command.start_address[1]};
            initial_in_slot  = '0;
        } else {
            case command.start_address[1:0] {
                2'd0   : initial_out_slot = 0 as OUT_SLOT_BITS;
                2'd1   : initial_out_slot = 3 as OUT_SLOT_BITS;
                2'd2   : initial_out_slot = 2 as OUT_SLOT_BITS;
                default: initial_out_slot = 1 as OUT_SLOT_BITS;
            }
            case command.start_address[1:0] {
                2'd0   : initial_in_slot = 0 as IN_SLOT_BITS;
                2'd1   : initial_in_slot = 2 as IN_SLOT_BITS;
                2'd2   : initial_in_slot = 1 as IN_SLOT_BITS;
                default: initial_in_slot = 0 as IN_SLOT_BITS;
            }
        }
    }

    // AR channel (registered)
    var ar_valid: logic             ;
    var ar_addr : logic<AddressBits>;
    var ar_len  : logic<8>          ;

    assign axi.arvalid = ar_valid;
    assign axi.ar.addr = ar_addr;
    assign axi.ar.len  = ar_len;

    // R channel through a large queue (Chisel: Queue(io.axi.r, 2048))
    inst r_enq: stream_if::<axi4_pkg::Axi4R::<32>>;
    inst r_deq: stream_if::<axi4_pkg::Axi4R::<32>>;

    inst u_r_fifo: sync_fifo::<axi4_pkg::Axi4R::<32>> #(
        DepthBits: RFifoDepthBits,
    ) (
        i_clk  : i_clk,
        i_rst  : i_rst,
        i_data : r_enq,
        o_data : r_deq,
        o_count: _    ,
    );

    assign r_enq.valid   = axi.rvalid;
    assign r_enq.payload = axi.r;
    assign axi.rready    = r_enq.ready;

    // Pixel assembled from the realignment buffer (little-endian bytes).
    // Selected by pixel slot: a plain 4:1 byte mux without index adders.
    var pixel_from_buffer: logic<video_pkg::PIXEL_BITS>;
    always_comb {
        case out_slot {
            0      : for i in 0..PIXEL_BYTES {
                pixel_from_buffer[8 * i+:8] = realign_buffer[i];
            }
            1      : for i in 0..PIXEL_BYTES {
                pixel_from_buffer[8 * i+:8] = realign_buffer[PIXEL_BYTES + i];
            }
            2      : for i in 0..PIXEL_BYTES {
                pixel_from_buffer[8 * i+:8] = realign_buffer[2 * PIXEL_BYTES + i];
            }
            default: for i in 0..PIXEL_BYTES {
                pixel_from_buffer[8 * i+:8] = realign_buffer[3 * PIXEL_BYTES + i];
            }
        }
    }

    // Output pixel stream (registered)
    var data_valid    : logic                       ;
    var data_bits     : logic<video_pkg::PIXEL_BITS>;
    var end_of_line   : logic                       ;
    var start_of_frame: logic                       ;

    assign o_data.valid                  = data_valid;
    assign o_data.payload.pixel_data     = data_bits;
    assign o_data.payload.end_of_line    = end_of_line;
    assign o_data.payload.start_of_frame = start_of_frame;

    assign o_command_ready = state == State::s_idle;
    assign o_busy          = state != State::s_idle;

    // Only accept R data against the current burst's counter. Accepting it
    // while the next burst's length is still in issued_data_words_remaining
    // (as the Chisel original did) lets the decrement below override the
    // "move issued length" assignment in the same cycle, underflowing
    // data_words_remaining so the line never completes. Costs one idle
    // cycle per burst.
    let can_input_data: logic = !realign_full && (data_words_remaining >: '0);
    assign r_deq.ready = (state == State::s_running) && can_input_data;

    always_ff {
        if_reset {
            state                       = State::s_idle;
            command                     = 0 as video_pkg::LineReaderCommand::<AddressBits, MaxWidth>;
            next_address                = '0;
            address_words_remaining     = '0;
            data_words_remaining        = '0;
            issued_data_words_remaining = '0;
            pixels_remaining            = '0;
            in_slot                     = '0;
            out_slot                    = '0;
            in_side                     = '0;
            out_side                    = '0;
            ar_valid                    = '0;
            ar_addr                     = '0;
            ar_len                      = '0;
            data_valid                  = '0;
            data_bits                   = '0;
            end_of_line                 = '0;
            start_of_frame              = '0;
        } else {
            if ar_valid && axi.arready {
                ar_valid = '0;
            }
            if data_valid && o_data.ready {
                data_valid     = '0;
                start_of_frame = '0;
            }

            case state {
                State::s_idle: {
                    if i_command_valid && o_command_ready {
                        command = i_command;
                        state   = State::s_decode;
                    }
                }
                State::s_decode: {
                    pixels_remaining = command.count;
                    start_of_frame   = command.start_of_frame;
                    // Input pointer starts word aligned; output pointer
                    // starts at the pixel phase within the first word.
                    in_slot                     = initial_in_slot;
                    out_slot                    = initial_out_slot;
                    in_side                     = '0;
                    out_side                    = '0;
                    address_words_remaining     = words_to_transfer;
                    data_words_remaining        = '0;
                    issued_data_words_remaining = '0;
                    next_address                = start_address_aligned;
                    state                       = State::s_running;
                }
                State::s_running: {
                    // Generate burst addresses
                    if (!ar_valid || axi.arready) && (address_words_remaining >: '0)
                        && (issued_data_words_remaining == '0) {
                        ar_addr  = next_address;
                        ar_valid = '1;
                        if address_words_remaining <: (READ_BURST_WORDS as WORDS_BITS) {
                            ar_len                      = (address_words_remaining - 1) as 8;
                            issued_data_words_remaining = address_words_remaining;
                            address_words_remaining     = '0;
                        } else {
                            ar_len                      = (READ_BURST_WORDS - 1) as 8;
                            issued_data_words_remaining = READ_BURST_WORDS as WORDS_BITS;
                            address_words_remaining     = address_words_remaining - (READ_BURST_WORDS as WORDS_BITS);
                        }
                        next_address = next_address + ((READ_BURST_WORDS * DATA_BYTES) as AddressBits);
                    }
                    // Move issued length to the data counter
                    if (issued_data_words_remaining != '0) && (data_words_remaining == '0) {
                        issued_data_words_remaining = '0;
                        data_words_remaining        = issued_data_words_remaining;
                    }
                    // Input a bus word into the realignment buffer
                    if can_input_data && r_deq.valid {
                        for i in 0..4 {
                            realign_buffer[{in_slot, i as 2}] = r_deq.payload.data[8 * i+:8];
                        }
                        data_words_remaining = data_words_remaining - 1;
                        if in_slot == ((IN_SLOTS - 1) as IN_SLOT_BITS) {
                            in_slot = '0;
                            in_side = ~in_side;
                        } else {
                            in_slot = in_slot + 1;
                        }
                    }
                    // Output a pixel from the realignment buffer
                    if !realign_empty && (pixels_remaining >: '0) && (!data_valid || o_data.ready) {
                        data_valid  = '1;
                        data_bits   = pixel_from_buffer;
                        end_of_line = pixels_remaining == 1;
                        if out_slot == ((OUT_SLOTS - 1) as OUT_SLOT_BITS) {
                            out_slot = '0;
                            out_side = ~out_side;
                        } else {
                            out_slot = out_slot + 1;
                        }
                        pixels_remaining = pixels_remaining - 1;
                    }

                    // Transfer complete?
                    if (address_words_remaining == '0) && (issued_data_words_remaining == '0)
                        && (data_words_remaining == '0) && (pixels_remaining == '0) {
                        state = State::s_idle;
                    }
                }
            }
        }
    }
}
