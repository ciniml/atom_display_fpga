// Unit test for video_pkg (video/video_pkg.veryl): the reusable timing
// types, sizing constants, and config helpers. ATOM-Display-specific
// presets are tested separately in test_video_presets (GPL).
// SPDX-License-Identifier: BSL-1.0

#[test(test_video_pkg)]
#[allow(unassign_variable)]
module test_video_pkg {
    const CNT_H_BITS: u32 = video_pkg::COUNT_H_BITS;
    const CNT_V_BITS: u32 = video_pkg::COUNT_V_BITS;
    const ADDR_BITS : u32 = video_pkg::ADDRESS_BITS;

    var cfg     : video_pkg::VideoConfig                      ;
    var vsignal : video_pkg::VideoSignal                      ;
    var video   : video_pkg::VideoIO                          ;
    var mult_cfg: video_pkg::VideoMultiplicationConfig::<8, 8>;

    initial {
        // Derived maximums (sizing basis)
        $assert(CNT_H_BITS == 12);
        $assert(CNT_V_BITS == 12);
        $assert(ADDR_BITS == 24);

        // VideoConfig packed width: 9+12+9+9+9+12+10+9 = 79
        $assert($bits(cfg) == 79);
        $assert($bits(vsignal) == 18);
        $assert($bits(video) == 19);
        $assert($bits(mult_cfg) == 8);

        // config_value + total_counts on a 720p-shaped timing
        // (bpV,pxV,fpV,pwV, bpH,pxH,fpH,pwH)
        cfg     = video_pkg::config_value(20, 720, 5, 5, 220, 1280, 110, 40);
        $assert(cfg.back_porch_v == 20);
        $assert(cfg.pixels_v == 720);
        $assert(cfg.front_porch_v == 5);
        $assert(cfg.pulse_width_v == 5);
        $assert(cfg.back_porch_h == 220);
        $assert(cfg.pixels_h == 1280);
        $assert(cfg.front_porch_h == 110);
        $assert(cfg.pulse_width_h == 40);
        $assert(video_pkg::total_counts_h(cfg) == 1650);
        $assert(video_pkg::total_counts_v(cfg) == 750);

        $finish();
    }
}
