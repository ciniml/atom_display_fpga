// Unit test for stream_reader / line_reader with tb_axi4_memory.
// Geometry: 16x8 pixels (line stride 16 * PIXEL_BYTES bytes). The test
// pre-fills memory through the same AXI interface's write channels
// (unused by the reader), then reads rectangles forward and backward
// (the backward path is what COPYRECT uses for overlapping moves).
// The pre-fill and expected values are computed per byte from the
// pixel index, so the test works for both 16bpp and 24bpp.
// SPDX-License-Identifier: BSL-1.0

#[test(test_stream_reader)]
#[allow(unassign_variable)]
module test_stream_reader {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (
        clk: clk,
    );

    inst axi   : axi4_if::<10, 32>;
    inst s_data: stream_if::<video_pkg::VideoSignal>;

    var cmd_valid: logic                                      ;
    var cmd_ready: logic                                      ;
    var cmd      : video_pkg::StreamReaderCommand::<10, 16, 8>;
    var busy     : logic                                      ;

    var s_data_valid  : logic                 ;
    var s_data_payload: video_pkg::VideoSignal;
    assign s_data.valid   = s_data_valid;
    assign s_data.payload = s_data_payload;

    inst dut: stream_reader::<10, 16, 8, 8, 16> (
        i_clk          : clk      ,
        i_rst          : rst      ,
        i_command_valid: cmd_valid,
        o_command_ready: cmd_ready,
        i_command      : cmd      ,
        o_data_valid   : s_data_valid  ,
        i_data_ready   : s_data.ready  ,
        o_data         : s_data_payload,
        axi            : axi      ,
        o_busy         : busy     ,
    );

    inst memory: tb_axi4_memory::<10, 32> #(
        MemWords: 256,
    ) (
        i_clk: clk,
        i_rst: rst,
        axi  : axi,
    );

    const PIXEL_BYTES: u32 = video_pkg::PIXEL_BYTES;
    const FILL_WORDS : u32 = 32 * PIXEL_BYTES / 4; // lines 0..1 = 32 pixels

    // pixel(x, y) = PX_BASE + y*16 + x (linear index; stride = width)
    function pixel_value (
        index: input u32,
    ) -> logic<video_pkg::PIXEL_BITS> {
        return (32'h00a1_b000 + index) as video_pkg::PIXEL_BITS;
    }

    // Little-endian pixel bytes laid out contiguously from address 0
    function fill_byte (
        byte_addr: input u32,
    ) -> logic<8> {
        var px  : logic<video_pkg::PIXEL_BITS>;
        var lane: u32                         ;
        px   = pixel_value(byte_addr / PIXEL_BYTES);
        lane = byte_addr % PIXEL_BYTES;
        return px[8 * lane+:8];
    }

    var expected : logic<video_pkg::PIXEL_BITS>;
    var fill_word: logic<32>                   ;

    initial {
        cmd_valid           = '0;
        cmd.address_offset  = '0;
        cmd.start_x         = '0;
        cmd.end_x_inclusive = '0;
        cmd.start_y         = '0;
        cmd.end_y_inclusive = '0;
        s_data.ready        = '1;
        // TB drives the write channels (unused by the reader)
        axi.awvalid = '0;
        axi.aw.addr = '0;
        axi.aw.len  = '0;
        axi.wvalid  = '0;
        axi.w.data  = '0;
        axi.w.strb  = '0;
        axi.w.last  = '0;
        axi.bready  = '1;
        rst.assert (clk);
        clk.next   (2);

        // ---- Pre-fill lines 0..1: pixel(x,y) = PX_BASE + y*16 + x ----
        axi.awvalid = '1;
        axi.aw.addr = 10'h000;
        axi.aw.len  = (FILL_WORDS - 1) as 8;
        for _i in 0..20 {
            if axi.awready {
                break;
            }
            clk.next(1);
        }
        clk.next   (1);
        axi.awvalid = '0;
        axi.wvalid  = '1;
        axi.w.strb  = 4'hf;
        for w in 0..FILL_WORDS {
            for b in 0..4 {
                fill_word[8 * b+:8] = fill_byte(w * 4 + b);
            }
            axi.w.data = fill_word;
            axi.w.last = w == FILL_WORDS - 1;
            for _i in 0..20 {
                if axi.wready {
                    break;
                }
                clk.next(1);
            }
            clk.next(1);
        }
        axi.wvalid = '0;
        for _i in 0..40 {
            if axi.bvalid {
                break;
            }
            clk.next(1);
        }
        $assert (axi.bvalid, "memory pre-fill must complete");
        clk.next(2);

        // ---- Forward read: x=1..6, y=0..1 ----
        cmd.start_x         = 1;
        cmd.end_x_inclusive = 6;
        cmd.start_y         = 0;
        cmd.end_y_inclusive = 1;
        cmd_valid           = '1;
        for _i in 0..10 {
            if cmd_ready {
                break;
            }
            clk.next(1);
        }
        $assert  (cmd_ready, "read command must be accepted");
        clk.next (1);
        cmd_valid = '0;

        for row in 0..2 {
            for px in 0..6 {
                for _i in 0..100 {
                    if s_data.valid {
                        break;
                    }
                    clk.next(1);
                }
                $assert (s_data.valid, "pixel must arrive");
                expected = pixel_value(row * 16 + 1 + px);
                $assert (s_data.payload.pixel_data == expected, "forward read pixel must match");
                $assert (s_data.payload.end_of_line == (px == 5), "end_of_line on last pixel of each line");
                clk.next(1);
            }
        }
        for _i in 0..100 {
            if !busy {
                break;
            }
            clk.next(1);
        }
        $assert (!busy, "forward read must complete");
        clk.next(2);

        // ---- Backward read: x=1..6, y=1 down to y=0 ----
        cmd.start_y         = 1;
        cmd.end_y_inclusive = 0;
        cmd_valid           = '1;
        for _i in 0..10 {
            if cmd_ready {
                break;
            }
            clk.next(1);
        }
        clk.next (1);
        cmd_valid = '0;

        for row in 0..2 {
            for px in 0..6 {
                for _i in 0..100 {
                    if s_data.valid {
                        break;
                    }
                    clk.next(1);
                }
                $assert (s_data.valid, "pixel must arrive (backward)");
                expected = pixel_value((1 - row) * 16 + 1 + px);
                $assert (s_data.payload.pixel_data == expected, "backward read must deliver line 1 then line 0");
                clk.next(1);
            }
        }
        for _i in 0..100 {
            if !busy {
                break;
            }
            clk.next(1);
        }
        $assert(!busy, "backward read must complete");

        $finish();
    }
}
