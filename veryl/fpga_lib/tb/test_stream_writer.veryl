// Unit test for stream_writer / line_writer with tb_axi4_memory.
// Geometry: 16x8 pixels (line stride 16 * PIXEL_BYTES bytes).
// Verifies fill rect with unaligned (odd) start X including byte
// strobes, and a streamed pixel write, by reading memory back through
// the same AXI interface's read channels (unused by the writer).
// The expected values are computed per byte from the written region,
// so the test works for both 16bpp and 24bpp.
// SPDX-License-Identifier: BSL-1.0

#[test(test_stream_writer)]
#[allow(unassign_variable)]
module test_stream_writer {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (
        clk: clk,
    );

    inst axi   : axi4_if::<10, 32>;
    inst s_data: stream_if::<video_pkg::VideoSignal>;

    var cmd_valid: logic                                      ;
    var cmd_ready: logic                                      ;
    var cmd      : video_pkg::StreamWriterCommand::<10, 16, 8>;
    var busy     : logic                                      ;

    var s_data_ready: logic;
    assign s_data.ready = s_data_ready;

    inst dut: stream_writer::<10, 16, 8, 8, 16> (
        i_clk          : clk      ,
        i_rst          : rst      ,
        i_command_valid: cmd_valid,
        o_command_ready: cmd_ready,
        i_command      : cmd      ,
        i_data_valid   : s_data.valid  ,
        o_data_ready   : s_data_ready  ,
        i_data         : s_data.payload,
        axi            : axi      ,
        o_busy         : busy     ,
    );

    inst memory: tb_axi4_memory::<10, 32> #(
        MemWords: 256,
    ) (
        i_clk: clk,
        i_rst: rst,
        axi  : axi,
    );

    var rword: logic<32>;

    function read_word_addr (
        waddr: input u32,
    ) -> logic<10> {
        return (waddr * 4) as 10;
    }

    const PIXEL_BYTES : u32 = video_pkg::PIXEL_BYTES;
    const STRIDE_BYTES: u32 = 16 * PIXEL_BYTES;
    const STRIDE_WORDS: u32 = STRIDE_BYTES / 4;

    let fill_color: video_pkg::PixelType = 32'h0000_1234 as video_pkg::PixelType;

    // Streamed pixel p value (16bpp: 0xa100 + p)
    function stream_pixel (
        p: input u32,
    ) -> logic<video_pkg::PIXEL_BITS> {
        return (32'h00a2_a100 + p) as video_pkg::PIXEL_BITS;
    }

    // Expected byte of the fill test at byte offset `off` within a
    // filled line: pixels x = 3..10 hold fill_color, the rest stay 0.
    function fill_expected_byte (
        off: input u32,
    ) -> logic<8> {
        var lane: u32;
        if (off >= 3 * PIXEL_BYTES) && (off <: 11 * PIXEL_BYTES) {
            lane = (off - 3 * PIXEL_BYTES) % PIXEL_BYTES;
            return fill_color[8 * lane+:8];
        } else {
            return 8'h00;
        }
    }

    // Expected byte of the streamed-write test at byte offset `off`
    // within line 4: pixels x = 0..7 hold stream_pixel(x).
    function stream_expected_byte (
        off: input u32,
    ) -> logic<8> {
        var px  : logic<video_pkg::PIXEL_BITS>;
        var lane: u32                         ;
        if off <: 8 * PIXEL_BYTES {
            px   = stream_pixel(off / PIXEL_BYTES);
            lane = off % PIXEL_BYTES;
            return px[8 * lane+:8];
        } else {
            return 8'h00;
        }
    }

    initial {
        cmd_valid                     = '0;
        cmd.address_offset            = '0;
        cmd.start_x                   = '0;
        cmd.end_x_inclusive           = '0;
        cmd.start_y                   = '0;
        cmd.end_y_inclusive           = '0;
        cmd.do_fill                   = '0;
        cmd.color                     = '0;
        s_data.valid                  = '0;
        s_data.payload.pixel_data     = '0;
        s_data.payload.start_of_frame = '0;
        s_data.payload.end_of_line    = '0;
        // TB drives the read channels (unused by the writer)
        axi.arvalid = '0;
        axi.ar.addr = '0;
        axi.ar.len  = '0;
        axi.rready  = '1;
        rst.assert (clk);
        clk.next   (2);

        // ---- Fill rect: x=3..10, y=1..2 ----
        cmd.start_x         = 3;
        cmd.end_x_inclusive = 10;
        cmd.start_y         = 1;
        cmd.end_y_inclusive = 2;
        cmd.do_fill         = '1;
        cmd.color           = fill_color;
        cmd_valid           = '1;
        for _i in 0..10 {
            if cmd_ready {
                break;
            }
            clk.next(1);
        }
        $assert  (cmd_ready, "fill command must be accepted");
        clk.next (1);
        cmd_valid = '0;

        for _i in 0..500 {
            if !busy {
                break;
            }
            clk.next(1);
        }
        $assert (!busy, "fill must complete");
        clk.next(2);

        // Read back each filled line in full and verify byte-wise:
        // pixels 3..10 hold fill_color (partial first/last bus words
        // exercise the byte strobes), everything else stays 0.
        for row in 0..2 {
            axi.arvalid = '1;
            axi.ar.addr = read_word_addr((1 + row) * STRIDE_WORDS);
            axi.ar.len  = (STRIDE_WORDS - 1) as 8;
            for _i in 0..20 {
                if axi.arready {
                    break;
                }
                clk.next(1);
            }
            clk.next   (1);
            axi.arvalid = '0;
            for beat in 0..STRIDE_WORDS {
                for _i in 0..20 {
                    if axi.rvalid {
                        break;
                    }
                    clk.next(1);
                }
                $assert(axi.rvalid, "readback beat must arrive");
                rword = axi.r.data;
                for lane in 0..4 {
                    $assert(
                        rword[8 * lane+:8] == fill_expected_byte(beat * 4 + lane),
                        "partial first word (odd start X)",
                    );
                }
                clk.next(1);
            }
        }

        // Untouched line 0 stays zero
        axi.arvalid = '1;
        axi.ar.addr = read_word_addr(1);
        axi.ar.len  = 8'd0;
        for _i in 0..20 {
            if axi.arready {
                break;
            }
            clk.next(1);
        }
        clk.next   (1);
        axi.arvalid = '0;
        for _i in 0..20 {
            if axi.rvalid {
                break;
            }
            clk.next(1);
        }
        $assert (axi.r.data == 32'h0000_0000, "outside the rect must stay 0");
        clk.next(2);

        // ---- Streamed write: x=0..7, y=4, pixels 0xa100..0xa107 ----
        cmd.start_x         = 0;
        cmd.end_x_inclusive = 7;
        cmd.start_y         = 4;
        cmd.end_y_inclusive = 4;
        cmd.do_fill         = '0;
        cmd_valid           = '1;
        for _i in 0..10 {
            if cmd_ready {
                break;
            }
            clk.next(1);
        }
        clk.next (1);
        cmd_valid = '0;

        s_data.valid = '1;
        for p in 0..8 {
            s_data.payload.pixel_data = stream_pixel(p);
            for _i in 0..40 {
                if s_data.ready {
                    break;
                }
                clk.next(1);
            }
            $assert (s_data.ready, "pixel must be consumed");
            clk.next(1);
        }
        s_data.valid = '0;

        for _i in 0..500 {
            if !busy {
                break;
            }
            clk.next(1);
        }
        $assert (!busy, "stream write must complete");
        clk.next(2);

        // Read back line 4 in full and verify byte-wise: pixels 0..7
        // hold stream_pixel(x) in order.
        axi.arvalid = '1;
        axi.ar.addr = read_word_addr(4 * STRIDE_WORDS);
        axi.ar.len  = (STRIDE_WORDS - 1) as 8;
        for _i in 0..20 {
            if axi.arready {
                break;
            }
            clk.next(1);
        }
        clk.next   (1);
        axi.arvalid = '0;
        for beat in 0..STRIDE_WORDS {
            for _i in 0..20 {
                if axi.rvalid {
                    break;
                }
                clk.next(1);
            }
            $assert (axi.rvalid);
            rword = axi.r.data;
            for lane in 0..4 {
                $assert(
                    rword[8 * lane+:8] == stream_expected_byte(beat * 4 + lane),
                    "streamed pixels must land in order",
                );
            }
            clk.next(1);
        }

        $finish();
    }
}
