// m5stack_hdmi_flat.veryl
// Flat-port synthesis wrapper around m5stack_hdmi for instantiation
// from the hand-written SystemVerilog top (eda/.../top.sv), replacing
// the Chisel-generated M5StackHDMI module. Port roles match the Chisel
// module's io_* ports; the SDRC address is truncated to the GOWIN
// SDRAM controller's 21 bits like the original top.sv connection.
// SPDX-License-Identifier: GPL-3.0-or-later

pub module m5stack_hdmi_flat (
    i_clk: input 'main clock,
    i_rst: input 'main reset,
    // Video clock domain
    io_videoClock      : input  'video clock    ,
    io_videoReset      : input  'video reset    ,
    io_video_pixelData : output 'video logic<16>,
    io_video_hSync     : output 'video logic    ,
    io_video_vSync     : output 'video logic    ,
    io_video_dataEnable: output 'video logic    ,
    io_dataInSync      : output 'video logic    ,
    // SPI bus (SCK/CS domains derived inside fpga_lib::spi_slave)
    io_spi_sck : input  'sckp clock,
    io_spi_mosi: input  'sckp logic,
    io_spi_miso: output 'sckp logic,
    io_spi_cs  : input  'sckp logic,
    // GOWIN SDRAM controller interface (main domain)
    io_sdrc_selfRefresh: output 'main logic    ,
    io_sdrc_powerDown  : output 'main logic    ,
    io_sdrc_wr_n       : output 'main logic    ,
    io_sdrc_rd_n       : output 'main logic    ,
    io_sdrc_addr       : output 'main logic<21>,
    io_sdrc_dataLen    : output 'main logic<7> ,
    io_sdrc_dqm        : output 'main logic<4> ,
    io_sdrc_dataRead   : input  'main logic<32>,
    io_sdrc_dataWrite  : output 'main logic<32>,
    io_sdrc_initDone   : input  'main logic    ,
    io_sdrc_busy_n     : input  'main logic    ,
    io_sdrc_rdValid    : input  'main logic    ,
    io_sdrc_wrdAck     : input  'main logic    ,
    // Status and video clock PLL reconfiguration (main domain)
    io_trigger                         : output 'main logic    ,
    io_processorIsBusy                 : output 'main logic    ,
    io_videoClockConfig_inputDivider   : output 'main logic<16>,
    io_videoClockConfig_outputDivider  : output 'main logic<16>,
    io_videoClockConfig_feedbackDivider: output 'main logic<16>,
    io_videoClockConfig_useHalfClock   : output 'main logic    ,
    io_videoClockConfigValid           : output 'main logic    ,
) {
    inst spi : fpga_lib::spi_if;
    inst sdrc: fpga_lib::sdrc_if::<22, 4, 80>;

    var video_out: 'video fpga_lib::video_pkg::VideoIO           ;
    var vclk_cfg : 'main  command_pkg::VideoClockConfig;

    // SPI pins <-> fpga_lib::spi_if
    assign spi.sck     = io_spi_sck;
    assign spi.mosi    = io_spi_mosi;
    assign spi.cs      = io_spi_cs;
    assign io_spi_miso = spi.miso;

    // SDRC <-> flat pins (address truncated to the 21-bit controller port)
    assign io_sdrc_selfRefresh = sdrc.self_refresh;
    assign io_sdrc_powerDown   = sdrc.power_down;
    assign io_sdrc_wr_n        = sdrc.wr_n;
    assign io_sdrc_rd_n        = sdrc.rd_n;
    assign io_sdrc_addr        = sdrc.addr[20:0];
    assign io_sdrc_dataLen     = sdrc.data_len;
    assign io_sdrc_dqm         = sdrc.dqm;
    assign sdrc.data_read      = io_sdrc_dataRead;
    assign io_sdrc_dataWrite   = sdrc.data_write;
    assign sdrc.init_done      = io_sdrc_initDone;
    assign sdrc.busy_n         = io_sdrc_busy_n;
    assign sdrc.rd_valid       = io_sdrc_rdValid;
    assign sdrc.wrd_ack        = io_sdrc_wrdAck;

    // Video output struct -> flat pins
    assign io_video_pixelData  = video_out.pixel_data;
    assign io_video_hSync      = video_out.h_sync;
    assign io_video_vSync      = video_out.v_sync;
    assign io_video_dataEnable = video_out.data_enable;

    // PLL reconfiguration struct -> flat pins
    assign io_videoClockConfig_inputDivider    = vclk_cfg.input_divider;
    assign io_videoClockConfig_outputDivider   = vclk_cfg.output_divider;
    assign io_videoClockConfig_feedbackDivider = vclk_cfg.feedback_divider;
    assign io_videoClockConfig_useHalfClock    = vclk_cfg.use_half_clock;

    inst u_top: m5stack_hdmi (
        i_clk                     : i_clk                   ,
        i_rst                     : i_rst                   ,
        i_video_clk               : io_videoClock           ,
        i_video_rst               : io_videoReset           ,
        spi                       : spi                     ,
        o_video                   : video_out               ,
        o_data_in_sync            : io_dataInSync           ,
        o_trigger                 : io_trigger              ,
        o_processor_is_busy       : io_processorIsBusy      ,
        sdrc                      : sdrc                    ,
        o_video_clock_config_valid: io_videoClockConfigValid,
        o_video_clock_config      : vclk_cfg                ,
        o_dbg_copy_rect           : _                       ,
    );
}
